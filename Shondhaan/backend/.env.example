PORT=5000
# CORS_ORIGIN=https://shondhaan.yessbd.top/
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shondhaan_db

# Optional. If omitted, Backend will also try ../Frontend/.env VITE_SUPABASE_* values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Yess Service <no-reply@example.com>"

OTP_EXPIRY_MINUTES=10
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_MOBILE=01700000001
SUPER_ADMIN_BOOTSTRAP_KEY=replace-with-a-secure-bootstrap-key
